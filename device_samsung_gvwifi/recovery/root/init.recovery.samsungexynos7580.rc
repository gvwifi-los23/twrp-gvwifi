# TWRP for the Galaxy View SM-T670 (gvwifi)

on init
    # USB: configfs gadget on the s3c_udc_otg controller (same as the LineageOS recovery)
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 13580000.usb
    setprop ro.recovery.usb.vid 04E8
    setprop ro.recovery.usb.adb.pid 6860
    setprop ro.recovery.usb.fastboot.pid 6860

    # (/vendor/lib/hw, /system/bin/bootstrap/linker and the VINTF framework manifest are
    #  added to the ramdisk by build-twrp.sh; doing it here did not take effect)

# Same keymaster and gatekeeper as the ROM: keymaster@3.0-service with its built-in
# software keymaster (no keystore.* hardware module is present) and the software gatekeeper.
service keymaster-3-0 /system/bin/android.hardware.keymaster@3.0-service
    user root
    group root
    seclabel u:r:recovery:s0
    disabled

service gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service.software
    user root
    group root
    seclabel u:r:recovery:s0
    disabled

# TWRP 14.1 sets ro.crypto.state once it has read the fstab, before it initializes the
# DE keys (it no longer sets crypto.ready, which older TWRP used)
on property:ro.crypto.state=encrypted
    start hwservicemanager
    start keymaster-3-0
    start gatekeeper-1-0

# MTP + adb (TWRP sets sys.usb.config=mtp,adb when MTP is enabled, always going through
# sys.usb.config=none first). Same layout as the ROM's init.usb.configfs.rc:
# f1 = mtp.gs0 (kernel f_mtp, /dev/mtp_usb), f2 = ffs.adb.
# These rules must be idempotent: adbd sets sys.usb.ffs.ready=1 again every time USB
# re-enumerates, which re-runs them. Unbinding here (UDC none) restarted that cycle and
# looped forever; only the none step below disconnects.
on fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/mtp.gs0

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    # The ROM's IDs (Samsung 04E8:6860, MTP + adb): Windows binds its MTP driver to this
    # composite. Under TWRP's adb IDs (18D1:D001) it only ever sets up the adb interface.
    write /config/usb_gadget/g1/idVendor 0x04E8
    write /config/usb_gadget/g1/idProduct 0x6860
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/mtp.gs0 /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# The stock none rule unbinds and removes only f1; drop f2 too and restore TWRP's vendor
# ID, so the stock adb rule (and sideload/fastboot) start from a clean config.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idVendor 0x${ro.recovery.usb.vid}
