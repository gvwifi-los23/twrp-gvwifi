# TWRP-only partitions and options (merged with recovery.fstab)
/system_root    ext4    /dev/block/platform/13540000.dwmmc0/by-name/SYSTEM      flags=display="System";backup=1;wipeingui
/system_image   emmc    /dev/block/platform/13540000.dwmmc0/by-name/SYSTEM      flags=display="System Image";backup=1;flashimg=1
/boot           emmc    /dev/block/platform/13540000.dwmmc0/by-name/BOOT        flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/platform/13540000.dwmmc0/by-name/RECOVERY    flags=display="Recovery";backup=1;flashimg=1
/efs            ext4    /dev/block/platform/13540000.dwmmc0/by-name/EFS         flags=display="EFS";backup=1
/efs_image      emmc    /dev/block/platform/13540000.dwmmc0/by-name/EFS         flags=display="EFS Image";backup=1
/radio          emmc    /dev/block/platform/13540000.dwmmc0/by-name/RADIO       flags=display="Radio";backup=1
/metadata       ext4    /dev/block/platform/13540000.dwmmc0/by-name/CACHE       flags=display="Metadata";backup=1
/external_sd    auto    /dev/block/mmcblk1p1    /dev/block/mmcblk1              flags=display="MicroSD";storage;wipeingui;removable
/usb-otg        auto    /dev/block/sda1         /dev/block/sda                  flags=display="USB OTG";storage;wipeingui;removable
